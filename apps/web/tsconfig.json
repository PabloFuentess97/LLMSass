{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@ai-node/ui": ["../../packages/ui/src"],
      "@ai-node/ui/*": ["../../packages/ui/src/*"],
      "@ai-node/types": ["../../packages/types/src"],
      "@ai-node/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
